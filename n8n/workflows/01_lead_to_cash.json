      "position": [
        600,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, stage: 'extraction', inquiry_id: $('Create Inquiry').item.json.inquiry_id, error: $json.error?.message || $json.error || 'unknown', note: 'Inquiry is stored; extraction can be retried safely.' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "0973d171-47ef-5043-ad80-f7d5fc2eab5d",
      "name": "Respond Extraction Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "56298b43-8f87-5da9-931e-153ed8cea9a6",
              "leftValue": "={{ $json.outcome }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "extracted"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "de33310c-1320-5c5d-aff5-a801b83a529b",
      "name": "Extracted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, inquiry_id: $json.inquiry_id, status: $json.status, outcome: 'needs_review', reasons: $json.review_reasons, next: 'A person will review this inquiry (exception queue).' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "ade74d92-b293-57ac-bc44-652bb5812c36",
      "name": "Respond Needs Review",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base_url }}/v1/inquiries/{{ $('Create Inquiry').item.json.inquiry_id }}/decide",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $('Config').item.json.request_id }}"
            }
          ]
        }
      },
      "id": "2fcf4b86-93ff-56ab-b897-f7009899aed5",
      "name": "Decide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, stage: 'decision', inquiry_id: $('Create Inquiry').item.json.inquiry_id, error: $json.error?.message || $json.error || 'unknown' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "3fe8486e-6c81-50bb-ad07-f27c6d7bde3d",
      "name": "Respond Decision Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        520
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, inquiry_id: $json.inquiry_id, status: $json.status, outcome: $json.outcome, reasons: $json.reasons, attempts: $('AI Extract').item.json.attempts, confidence: $('AI Extract').item.json.confidence, product: $('AI Extract').item.json.product, rule_version: $json.rule_version, extracted: $('AI Extract').item.json.extracted, requested_terms: $json.amounts, approval: $json.approval ? { approval_id: $json.approval.approval_id, required_role: $json.approval.required_role, status: $json.approval.status, expires_at: $json.approval.expires_at } : null, approval_form_url: ($json.approval && $json.approval.status === 'pending') ? $execution.resumeFormUrl : null } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "87720c3a-70e1-5dee-a028-e060d82a15dc",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "679022c4-76f5-5859-9d6c-9c3bd217f546",
                    "leftValue": "={{ $('Decide').item.json.outcome }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "auto_approve"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto approved"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "cb609a02-5ec2-5894-bf5c-9892c7ebddcf",
                    "leftValue": "={{ $('Decide').item.json.approval?.status }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "pending"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "needs approval"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "closed"
        }
      },
