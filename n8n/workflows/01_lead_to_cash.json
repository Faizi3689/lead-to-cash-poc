{
  "name": "01 - Lead-to-Cash (Inquiry -> Approval -> Documents)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inquiry",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "2fb161a1-10e8-53ce-90a2-52bfd54061f4",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "l2c-inquiry"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9a589865-18bd-5a0d-ba9f-6907b5097fe9",
              "name": "api_base_url",
              "value": "https://lead-to-cash-api.onrender.com",
              "type": "string"
            },
            {
              "id": "e8c2dd20-29e3-5cc8-9a3c-f768387bf87c",
              "name": "request_id",
              "value": "=n8n-{{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "fdec2c12-166a-5f99-88b8-3ba0b65b3ff8",
              "name": "idempotency_key",
              "value": "={{ $json.body.message_id ? 'msg-' + $json.body.message_id : 'sha-' + JSON.stringify($json.body).hash('sha256') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "3251febf-f9cd-5a68-92bc-a9c848ae8d0d",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base_url }}/v1/inquiries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $('Config').item.json.request_id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Config').item.json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Webhook').item.json.body.message, customer_name: $('Webhook').item.json.body.customer_name || null, customer_email: $('Webhook').item.json.body.customer_email || null, source: 'webhook' }) }}"
      },
      "id": "ad912526-a5c3-5856-8813-20b37b46df96",
      "name": "Create Inquiry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, stage: 'intake', error: $json.error?.message || $json.error || 'unknown' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "49e8bfb4-a7ed-50f0-8c4e-d6eec0324fad",
