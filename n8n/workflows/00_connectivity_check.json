{
  "name": "00 - Connectivity Check",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "l2c-ping",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "l2c-ping"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api-base",
              "name": "api_base_url",
              "value": "https://REPLACE-WITH-YOUR-TUNNEL.trycloudflare.com",
              "type": "string"
            },
            {
              "id": "cfg-request-id",
              "name": "request_id",
              "value": "={{ $json.headers['x-request-id'] || $execution.id }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.api_base_url }}/v1/ping",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Request-ID", "value": "={{ $json.request_id }}" }
          ]
        },
        "options": { "timeout": 10000 }
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Call Python API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { n8n: 'ok', request_id: $('Config').item.json.request_id, python_api: $json } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { n8n: 'ok', request_id: $('Config').item.json.request_id, python_api: 'unreachable', error: $json.error?.message || $json.error || 'unknown' } }}",
        "options": { "responseCode": 503 }
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Respond API Down",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 100]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Call Python API", "type": "main", "index": 0 }]] },
    "Call Python API": {
      "main": [
        [{ "node": "Respond OK", "type": "main", "index": 0 }],
        [{ "node": "Respond API Down", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
