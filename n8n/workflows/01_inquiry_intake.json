{
  "name": "01 - Inquiry Intake & AI Extraction",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "inquiry", "responseMode": "responseNode", "options": {} },
      "id": "b1f0c001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "l2c-inquiry"
    },
    {
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ JSON.stringify($json.body) }}",
        "dataPropertyName": "body_hash"
      },
      "id": "b1f0c001-0000-4000-8000-000000000002",
      "name": "Hash Body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "api_base_url", "value": "https://lead-to-cash-api.onrender.com", "type": "string" },
            { "id": "c2", "name": "request_id", "value": "=n8n-{{ $execution.id }}", "type": "string" },
            { "id": "c3", "name": "idempotency_key", "value": "={{ $('Webhook').item.json.body.message_id ? 'msg-' + $('Webhook').item.json.body.message_id : 'sha-' + $json.body_hash }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1f0c001-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base_url }}/v1/inquiries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Idempotency-Key", "value": "={{ $json.idempotency_key }}" },
            { "name": "X-Request-ID", "value": "={{ $json.request_id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Webhook').item.json.body.message, customer_name: $('Webhook').item.json.body.customer_name || null, customer_email: $('Webhook').item.json.body.customer_email || null, source: 'webhook' }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "b1f0c001-0000-4000-8000-000000000004",
      "name": "Create Inquiry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base_url }}/v1/inquiries/{{ $json.inquiry_id }}/extract",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "X-Request-ID", "value": "={{ $('Config').item.json.request_id }}" } ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "b1f0c001-0000-4000-8000-000000000005",
      "name": "AI Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, -100],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, inquiry_id: $json.inquiry_id, status: $json.status, outcome: $json.outcome, duplicate: $('Create Inquiry').item.json.duplicate, product: $json.product, extracted: $json.extracted, review_reasons: $json.review_reasons } }}",
        "options": { "responseCode": 200 }
      },
      "id": "b1f0c001-0000-4000-8000-000000000006",
      "name": "Respond Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1080, -200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, stage: 'extraction', inquiry_id: $('Create Inquiry').item.json.inquiry_id, error: $json.error?.message || $json.error || 'unknown', note: 'Inquiry is stored; extraction can be retried safely.' } }}",
        "options": { "responseCode": 502 }
      },
      "id": "b1f0c001-0000-4000-8000-000000000007",
      "name": "Respond Extraction Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1080, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { request_id: $('Config').item.json.request_id, stage: 'intake', error: $json.error?.message || $json.error || 'unknown' } }}",
        "options": { "responseCode": 502 }
      },
      "id": "b1f0c001-0000-4000-8000-000000000008",
      "name": "Respond Intake Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [840, 150]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Hash Body", "type": "main", "index": 0 }]] },
    "Hash Body": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Create Inquiry", "type": "main", "index": 0 }]] },
    "Create Inquiry": {
      "main": [
        [{ "node": "AI Extract", "type": "main", "index": 0 }],
        [{ "node": "Respond Intake Error", "type": "main", "index": 0 }]
      ]
    },
    "AI Extract": {
      "main": [
        [{ "node": "Respond Result", "type": "main", "index": 0 }],
        [{ "node": "Respond Extraction Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
