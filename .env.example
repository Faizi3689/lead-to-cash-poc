# ---- App ----
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
API_KEY=change-me              # shared key n8n sends in X-API-Key header

# ---- Database (Supabase Postgres) ----
# Supabase > Project Settings > Database > Connection string > "Session pooler" (IPv4-friendly)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- LLM ----
LLM_PROVIDER=mock              # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MIN_CONFIDENCE=0.75        # below this -> human review
LLM_RETRY_BACKOFF_SECONDS=1    # wait between LLM retries (x attempt number)

# ---- n8n ----
N8N_BASE_URL=http://localhost:5678

# ---- Commercial documents ----
BUSINESS_TIMEZONE=UTC          # e.g. Asia/Karachi, Asia/Singapore
QUOTE_VALID_DAYS=14
INVOICE_DUE_DAYS=30
MOCK_CALENDAR_FAIL=false       # true = simulate calendar outage (demo)

# ---- Financial controls ----
INVOICE_APPROVAL_THRESHOLD=100000
EXPENSE_APPROVAL_THRESHOLD=1000
RECEIPT_REQUIRED_ABOVE=25
